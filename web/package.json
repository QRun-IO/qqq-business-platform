{
  "name": "qqq-business-platform-web",
  "version": "1.0.0",
  "private": true,
  "description": "QQQ Business Platform - Next.js Frontend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run lib",
    "test:e2e": "playwright test",
    "test:e2e:precommit": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run type-check && npm run test && npm run test:e2e",
    "prebuild": "npm run test:all",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@keycloak/keycloak-admin-client": "^23.0.4",
