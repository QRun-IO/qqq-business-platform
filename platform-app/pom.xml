<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.qrun</groupId><artifactId>qqq-business-platform</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>platform-app</artifactId>
  <name>QQQ Business Platform Application</name>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>io.qrun</groupId><artifactId>platform-db</artifactId></dependency>
    <dependency><groupId>io.qrun</groupId><artifactId>qbit-identity</artifactId></dependency>
    <dependency><groupId>io.qrun</groupId><artifactId>qbit-content</artifactId></dependency>
    <dependency><groupId>io.qrun</groupId><artifactId>qbit-newsletter</artifactId></dependency>
    <dependency><groupId>io.qrun</groupId><artifactId>qbit-crm</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><executions><execution><goals><goal>repackage</goal></goals></execution></executions></plugin>
    <plugin><groupId>com.google.cloud.tools</groupId><artifactId>jib-maven-plugin</artifactId><configuration>
      <from><image>eclipse-temurin:21-jre</image></from><to><image>${jib.to.image}</image></to>
      <container><ports><port>8080</port></ports><creationTime>USE_CURRENT_TIMESTAMP</creationTime></container>
    </configuration></plugin>
  </plugins></build>
  <properties><jib.to.image>qqq-business-platform:${project.version}</jib.to.image></properties>
</project>
