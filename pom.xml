<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.qrun</groupId>
  <artifactId>qqq-business-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>QQQ Business Platform</name>
  <description>Open-source business platform distribution</description>
  <url>https://github.com/QRun-IO/qqq-business-platform</url>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.1</spring-boot.version>
    <liquibase.version>4.29.0</liquibase.version>
    <jib.version>3.4.3</jib.version>
  </properties>

  <modules>
    <module>platform-bom</module>
    <module>qbits/identity</module>
    <module>qbits/content</module>
    <module>qbits/newsletter</module>
    <module>qbits/crm</module>
    <module>db</module>
    <module>platform-app</module>
    <module>web</module>
    <module>deploy</module>
    <module>tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- The reactor parent cannot import its child platform-bom: that creates a Maven model cycle. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.liquibase</groupId>
        <artifactId>liquibase-core</artifactId>
        <version>${liquibase.version}</version>
      </dependency>
      <dependency><groupId>io.qrun</groupId><artifactId>platform-db</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.qrun</groupId><artifactId>qbit-identity</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.qrun</groupId><artifactId>qbit-content</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.qrun</groupId><artifactId>qbit-newsletter</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.qrun</groupId><artifactId>qbit-crm</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.2.5</version></plugin>
        <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version></plugin>
        <plugin><groupId>com.google.cloud.tools</groupId><artifactId>jib-maven-plugin</artifactId><version>${jib.version}</version></plugin>
      </plugins>
    </pluginManagement>
  </build>

  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url><distribution>repo</distribution></license></licenses>
</project>
